{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "stellar-dlmm": {
      "root": "artifacts/stellar-dlmm",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "api-server" },
    { "source": "/api", "destination": "api-server" },
    { "source": "/(.*)", "destination": "stellar-dlmm" }
  ]
}